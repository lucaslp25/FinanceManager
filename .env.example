# arquivo de exemplo de como o arquivo (.env) deve ser configurado
# copie esse arquivo e tire o .example e configure conforme seu gosto e o passo a passo


# BANCO DE DADOS --> colocar apenas uma senha se quiser para acessar o servidor do banco de dados dentro do pg admin

DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=


# AUTENTICACAO VIA JWT -> nao precisa mexer aqui

JWT_SECRET=a_super_longa_para_testes


# PG-ADMIN > altere apenas a senha se quiser acessar o pg admin pelo localhost:5050

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=suasenhaaqui


# -- EMAIL CONFIGURATION --

# --- MODO DESENVOLVIMENTO (MAILPIT) ---> nao mexer aqui

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME="noreply@financemanager.com"
MAIL_PASSWORD=""
MAIL_AUTH=false
MAIL_TLS=false


# -- LINK DO CORPO DO EMAIL (VIA DOCKER) --> nao mexer aqui
 
API_FRONTEND_URL=http://localhost:80


